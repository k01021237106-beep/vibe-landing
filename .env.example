# 이 파일을 .env.local로 복사해서 값을 채운다.
# .env.local은 절대 커밋하지 않는다.

# ---------------------------------------------------------------- Supabase
# 대시보드 → Project Settings → API 에서 확인한다.
# 아래 두 값은 브라우저에도 내려간다. 공개돼도 안전한 값이다 —
# 이 키로 할 수 있는 일은 전부 RLS 정책이 정하기 때문이다.
# 그래서 RLS를 끄면 이 키가 곧 데이터베이스 전체 열쇠가 된다. 끄지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------- 무료 1강
# 무료 1강 접근권 쿠키에 서명하는 비밀키. 서버 전용이다.
# 무료 1강은 로그인을 요구하지 않으므로, 이 서명이 '신청한 사람'임을 증명하는
# 유일한 수단이다. 아무 값이나 넣지 말고 임의의 긴 문자열을 쓴다(16자 이상).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LEAD_ACCESS_SECRET=

# service_role 키. RLS를 우회하므로 서버에서만 쓴다.
# lessons.vimeo_id는 anon·authenticated에 컬럼 권한이 없어 이 키로만 읽을 수 있다.
# ⚠️ 유출되면 데이터베이스 전체가 열린다. NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- 결제
# 토스페이먼츠 개발자센터에서 받는다. 테스트키로 시작할 수 있다.
#
# Client Key는 결제창을 여는 데 쓰이므로 브라우저로 나가도 된다.
# Secret Key는 승인 요청에 쓰이며 서버 전용이다 —
# ⚠️ NEXT_PUBLIC_ 접두사를 붙이면 안 된다. 붙이는 순간 결제를 임의로 승인할 수 있게 된다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---------------------------------------------------------------- 개발 편의
# 데이터베이스에 닿지 못하는 환경에서 화면만 확인할 때 1로 둔다.
# 고정 데이터(lib/fixtures/content.ts)로 강의·후기·FAQ를 채운다.
# 운영 빌드에서는 켜지지 않는다 — lib/content.ts의 NODE_ENV 검사를 보라.
# USE_CONTENT_FIXTURES=1
