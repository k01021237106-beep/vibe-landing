{
  "name": "vibe-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/setup-fonts.mjs && next dev --turbopack",
    "prebuild": "node scripts/setup-fonts.mjs",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:layout": "node scripts/check-layout.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "check:preview": "node scripts/check-preview-card.mjs",
    "test:db": "bash scripts/test-db.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "og": "node scripts/generate-og-image.mjs",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:env": "node scripts/check-env.mjs",
    "check:dns": "node scripts/check-dns.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "@tosspayments/tosspayments-sdk": "^2.8.1",
